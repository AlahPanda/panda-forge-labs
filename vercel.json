{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|svg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projects",
      "destination": "/modpacks",
      "permanent": true
    },
    {
      "source": "/legal",
      "has": [
        {
          "type": "query",
          "key": "kind",
          "value": "privacy"
        }
      ],
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/legal",
      "has": [
        {
          "type": "query",
          "key": "kind",
          "value": "terms"
        }
      ],
      "destination": "/legal/terms",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/sync-modrinth",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/modrinth/:slug",
      "destination": "/api/modrinth?slug=:slug"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/news?slug=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/news.ts": {
      "includeFiles": "dist/{index.html,news-index.json}"
    }
  }
}
